{
  "name": "ghost-nexora-bot",
  "version": "1.1.0",
  "private": true,
  "description": "Ghost Nexora Bot - WhatsApp Multi-Device bot, economy, subbots and Next.js web",
  "workspaces": ["apps/*"],
  "scripts": {
    "assets:waifus": "node scripts/extract-waifus.mjs",
    "build": "npm run assets:waifus && npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "bot": "npm run start --workspace=@ghostnexora/bot",
    "pair": "npm run pair --workspace=@ghostnexora/bot",
    "web": "npm run start --workspace=@ghostnexora/web",
    "llm:train": "npm run llm:train --workspace=@ghostnexora/bot"
  },
  "overrides": {
    "redstar": {
      "minimatch": "3.1.5"
    }
  },
  "dependencies": {
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.8.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
