{
  "name": "@ghostnexora/bot",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "pair": "node dist/pair.js",
    "termux:start": "NEXORA_RUNTIME_PROFILE=termux-lite node dist/termux-lite.js",
    "termux:pair": "NEXORA_RUNTIME_PROFILE=termux-lite node dist/pair.js",
    "llm:train": "node dist/llm/train.js",
    "llm:worker": "node dist/llm/llm-worker-supervisor.js",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "baileys": "7.0.0-rc14",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.1",
    "execa": "^9.6.0",
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5",
    "pino": "^9.9.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "yt-search": "^2.13.1",
    "zod": "^4.1.5"
  },
  "optionalDependencies": {
    "playwright": "^1.55.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.5",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/yt-search": "^2.10.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
