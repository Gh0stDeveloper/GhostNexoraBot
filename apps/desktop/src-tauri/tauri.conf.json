{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ghost Nexora Manager",
  "version": "0.1.0",
  "identifier": "com.ghostnexora.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ghost Nexora Manager",
        "width": 1180,
        "height": 780,
        "minWidth": 820,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "Official Ghost Nexora Bot manager",
    "longDescription": "Manage Ghost Nexora Bot runtimes, platforms, pairing, configuration, updates, metrics and logs.",
    "windows": { "nsis": { "installMode": "currentUser" } },
    "linux": { "deb": { "depends": [] } }
  }
}
