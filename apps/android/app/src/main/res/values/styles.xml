<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/ghost_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/ghost_background</item>
        <item name="android:colorAccent">@color/ghost_primary</item>
        <item name="android:windowSplashScreenBackground">@color/ghost_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_nexora_splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ghost_surface</item>
        <item name="android:windowSplashScreenAnimationDuration">280</item>
    </style>
</resources>
