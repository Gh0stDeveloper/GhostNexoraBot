# Runtime: full para VPS/servidor, termux-lite lo configura automáticamente install-termux.sh
NEXORA_RUNTIME_PROFILE=full
BOT_NAME=Ghost Nexora Bot
PREFIX=.
OWNER_NUMBERS=5210000000000
AUTO_REACT=true
MAX_DOWNLOAD_MB=1900
SESSION_DIR=./data/session
DATA_DIR=./data
BOT_HEALTH_PORT=3001
BOT_HEALTH_URL=http://127.0.0.1:3001/health

# Dashboard web opcional. Las instalaciones antiguas sin esta clave se consideran habilitadas
# para conservar compatibilidad durante actualizaciones.
WEB_ENABLED=true
WEB_PORT=3000
PUBLIC_WEB_URL=https://bot.example.com
ADMIN_WEB_TOKEN=

ADULT_PRIVATE_ENABLED=true
EROME_COOKIE=
WELCOME_IMAGE_URL=
OFFICIAL_CHANNEL_URL=https://whatsapp.com/channel/0029VbCWbix9RZAfkkKOqP2i

# Lempi downloads
# Preferred: add up to 5 or more keys, separated by commas or new lines.
# The bot rotates automatically after 190 requests per key or when a quota response is detected.
LEMPI_API_KEYS=
# Legacy single-key compatibility:
LEMPI_API_KEY=
LEMPI_BASE_URL=https://api.lempi.lat
LEMPI_YOUTUBE_AUDIO_ENDPOINT=/dl/yta
LEMPI_YOUTUBE_VIDEO_ENDPOINT=/dl/ytv
LEMPI_FACEBOOK_ENDPOINT=/dl/facebook
# Endpoint candidates are tried in order; the first working route is used.
LEMPI_INSTAGRAM_ENDPOINTS=/d/instagram,/d/ig,/d/igdl,/d/igimg,/download/instagram,/download/ig
LEMPI_PINTEREST_SEARCH_ENDPOINTS=/s/pin,/s/pinterest,/search/pinterest
LEMPI_HAPPYMOD_SEARCH_ENDPOINTS=/s/happymod,/s/hm,/search/happymod,/search/hm
LEMPI_HAPPYMOD_DOWNLOAD_ENDPOINTS=/d/happymod,/d/hm,/d/happymoddl,/download/happymod,/download/hm

# Proveedores heredados/fallback de descargas
APICAUSAS_API_KEY=
PIPED_API_URLS=
# Instancias Cobalt propias (recomendado). Separadas por coma.
# Ejemplo: https://cobalt.tudominio.com
COBALT_API_URLS=
COBALT_API_KEY=
# Cookies Netscape para yt-dlp (Instagram y otros). Opcional pero mejora IG.
# Ejemplo: /var/lib/ghost-nexora-bot/cookies/instagram.txt
YTDLP_COOKIES_FILE=

# IA HTTP/remota (independiente de Ollama)
OPENROUTER_API_KEY=
AI_MODEL=openrouter/free
AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# LLM local opcional. El instalador VPS/Windows pregunta en la primera instalación.
OLLAMA_ENABLED=false
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_MS=360000
OLLAMA_QUEUE_WAIT_MS=360000
OLLAMA_MAX_QUEUE=8
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PREDICT=768
OLLAMA_TEMPERATURE=0.65
OLLAMA_TOP_P=0.9
OLLAMA_MAX_HISTORY=10

# Telegram → WhatsApp bridge
# El bot de Telegram debe estar en tu canal y recibir channel_post updates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_URL=

# Opcionales para Gelbooru/reacciones 18+.
GELBOORU_API_KEY=
GELBOORU_USER_ID=

LOG_LEVEL=info
