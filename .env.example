BOT_NAME=Ghost Nexora Bot
PREFIX=.
OWNER_NUMBERS=
AUTO_REACT=true
MAX_DOWNLOAD_MB=1900
SESSION_DIR=./data/session
DATA_DIR=./data
BOT_HEALTH_PORT=3001
BOT_HEALTH_URL=http://127.0.0.1:3001/health
WEB_PORT=3000
PUBLIC_WEB_URL=http://127.0.0.1:3000
ADMIN_WEB_TOKEN=change-this-admin-token
ADULT_PRIVATE_ENABLED=true
# Opcional: Cookie completa exportada de una sesión Erome iniciada manualmente.
# El login web actual de Erome utiliza e-mail + contraseña + CAPTCHA; el bot no intenta eludir el CAPTCHA.
# Sin esta variable, .erome funciona con el contenido público/anónimo.
EROME_COOKIE=
WELCOME_IMAGE_URL=
OFFICIAL_CHANNEL_URL=https://whatsapp.com/channel/0029VbCWbix9RZAfkkKOqP2i

# YouTube: opcional. Si se deja vacío, el bot consulta cobalt.directory y rota
# entre instancias Cobalt comunitarias que reportan soporte para YouTube.
# Si administras una instancia propia/privada, agrega una o más URLs separadas por coma.
COBALT_API_URLS=
# Se envía únicamente a las instancias definidas manualmente en COBALT_API_URLS.
COBALT_API_KEY=

# IA gratuita mediante OpenRouter. El modelo por defecto selecciona automáticamente
# uno de los modelos gratuitos disponibles. Requiere una API key de OpenRouter.
OPENROUTER_API_KEY=
AI_MODEL=openrouter/free
AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions

LOG_LEVEL=info
