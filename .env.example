BOT_NAME=Ghost Nexora Bot
PREFIX=.
OWNER_NUMBERS=5210000000000
AUTO_REACT=true
MAX_DOWNLOAD_MB=1900
SESSION_DIR=./data/session
DATA_DIR=./data
BOT_HEALTH_PORT=3001
BOT_HEALTH_URL=http://127.0.0.1:3001/health
WEB_PORT=3000
PUBLIC_WEB_URL=https://bot.example.com
ADMIN_WEB_TOKEN=
ADULT_PRIVATE_ENABLED=true
EROME_COOKIE=
WELCOME_IMAGE_URL=
OFFICIAL_CHANNEL_URL=https://whatsapp.com/channel/0029VbCWbix9RZAfkkKOqP2i

# API Lempi: proveedor principal para YouTube y respaldo de Facebook.
# Crea tu key en https://api.lempi.lat y pégala únicamente en el .env privado de la VPS.
# Si una key se expone en un chat, log o captura, revócala/regénérala antes de seguir usándola.
LEMPI_API_KEY=
LEMPI_BASE_URL=https://api.lempi.lat
# Endpoints actuales de API Lempi. Puedes sobreescribirlos si el proveedor los cambia.
LEMPI_YOUTUBE_AUDIO_ENDPOINT=/dl/yta
LEMPI_YOUTUBE_VIDEO_ENDPOINT=/dl/ytv
LEMPI_FACEBOOK_ENDPOINT=/dl/facebook

# Proveedores heredados/fallback de descargas. Conservados para compatibilidad.
APICAUSAS_API_KEY=
PIPED_API_URLS=
COBALT_API_URLS=
COBALT_API_KEY=

OPENROUTER_API_KEY=
AI_MODEL=openrouter/free
AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# Opcionales para Gelbooru/reacciones 18+.
GELBOORU_API_KEY=
GELBOORU_USER_ID=

LOG_LEVEL=info
