BOT_NAME=Ghost Nexora Bot
PREFIX=.
OWNER_NUMBERS=5210000000000
AUTO_REACT=true
MAX_DOWNLOAD_MB=1900
SESSION_DIR=./data/session
DATA_DIR=./data
BOT_HEALTH_PORT=3001
BOT_HEALTH_URL=http://127.0.0.1:3001/health
WEB_PORT=3000
PUBLIC_WEB_URL=https://bot.example.com
ADMIN_WEB_TOKEN=
ADULT_PRIVATE_ENABLED=true
EROME_COOKIE=
WELCOME_IMAGE_URL=
OFFICIAL_CHANNEL_URL=https://whatsapp.com/channel/0029VbCWbix9RZAfkkKOqP2i

# YouTube: opcional. Puedes fijar instancias Piped preferidas separadas por coma.
# Para MP3, el bot prioriza un stream de audio completo de Piped y lo convierte localmente
# a MP3 con FFmpeg; luego valida integridad/duración con ffprobe antes de enviarlo.
PIPED_API_URLS=
# Cobalt queda disponible como fallback o para una instancia propia/privada.
COBALT_API_URLS=
COBALT_API_KEY=

# IA gratuita mediante OpenRouter. Las API keys actuales de OpenRouter normalmente
# comienzan con sk-or-v1-. No publiques esta clave ni la pegues en chats/logs.
OPENROUTER_API_KEY=
AI_MODEL=openrouter/free
AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# Stickers: FFmpeg/FFprobe y webpmux se instalan/verifican con los scripts de despliegue.
# El pack por defecto es "Nexora Bot | Nexora" y cada usuario puede cambiar pack/autor.
# Subbots: el QR de fallback se genera localmente en la VPS; no necesita servicio externo.

LOG_LEVEL=info
