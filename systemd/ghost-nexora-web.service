[Unit]
Description=Ghost Nexora Bot Web
After=network-online.target ghost-nexora-bot.service
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__INSTALL_DIR__
Environment=NODE_ENV=production
Environment=ENV_FILE=__INSTALL_DIR__/.env
Environment=PORT=__WEB_PORT__
Environment=BOT_HEALTH_URL=http://127.0.0.1:__BOT_HEALTH_PORT__/health
ExecStart=/usr/bin/env npm --prefix __INSTALL_DIR__ run web
Restart=always
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# Keep the persistent state read-only by default. The Operations Center only
# needs write access to the SQLite/data subtree; WhatsApp session credentials
# remain outside that exception and therefore stay read-only to the web process.
ReadOnlyPaths=__STATE_DIR__
ReadWritePaths=__STATE_DIR__/data __INSTALL_DIR__/apps/web/.next/cache

[Install]
WantedBy=multi-user.target
